{
  "name": "opener",
  "displayName": "Opener",
  "description": "Lightweight, automatic file opener for VS Code and Code OSS",
  "version": "0.0.3",
  "publisher": "local",
  "private": true,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabler/icons": "^3.52.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "typescript": "5"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "opener.preview",
        "displayName": "Opener",
        "selector": [
          { "filenamePattern": "*.pdf" }
        ],
        "priority": "default"
      }
    ]
  }
}

{
  "name": "mango-opener",
  "displayName": "Opener",
  "description": "Lightweight, automatic file opener for VS Code and Code OSS",
  "version": "0.1.0",
  "publisher": "ubiufboeuf",
  "license": "MIT",
  "private": true,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ubiufboeuf/opener.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@tabler/icons": "^3.52.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "5"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "opener.preview",
        "displayName": "Opener",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
